{
  "name": "huecraft",
  "version": "0.1.0",
  "description": "Design-token studio: one brand color in, a complete accessible design system out (OKLCH scales, light/dark semantic tokens, fluid type, exports).",
  "license": "MIT",
  "author": "Habibeyilmazz",
  "repository": "github:Habibeyilmazz/huecraft",
  "type": "module",
  "bin": {
    "huecraft": "dist-cli/cli.js"
  },
  "files": [
    "dist-cli"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --port 4140 --strictPort",
    "build": "vite build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "preview": "vite preview --port 4141 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "e2e": "node scripts/e2e.mjs",
    "prepare": "npm run build:cli"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@types/node": "22.20.5",
    "axe-core": "4.14.1",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
